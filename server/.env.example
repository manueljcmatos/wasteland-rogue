# Token from @BotFather (keep it secret, never commit it)
BOT_TOKEN=
# Any long random string; Telegram sends it back on every webhook call
WEBHOOK_SECRET=
# Public HTTPS address of this server, e.g. https://wasteland-rogue.onrender.com
PUBLIC_URL=
# Where the game is hosted (the Mini App URL)
GAME_URL=https://manueljcmatos.github.io/wasteland-rogue/
# Origins allowed to call the API (the game's origin)
ALLOWED_ORIGINS=https://manueljcmatos.github.io
# Your Telegram numeric user id(s), comma separated, for /refund
ADMIN_IDS=
# Text shown for /paysupport (required by Telegram for Stars payments)
SUPPORT_CONTACT=Write to @your_support_username
# Max gems a player can earn from gameplay per day
DAILY_EARN_CAP=60
# SQLite file; put it on a persistent disk in production
DB_PATH=./data/game.db
PORT=8080
